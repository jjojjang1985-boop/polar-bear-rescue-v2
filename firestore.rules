rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all (Global Safety Net)
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive validation helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email == 'jjojjang1985@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    function isValidLeaderboard(data) {
      return data.keys().hasAll(['name', 'code', 'score', 'stars', 'avatar', 'createdAt']) &&
        data.keys().hasOnly(['name', 'code', 'score', 'stars', 'avatar', 'createdAt']) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 20 &&
        data.code is string && data.code.size() >= 1 && data.code.size() <= 20 &&
        data.score is int && data.score >= 0 && data.score <= 100000 &&
        data.stars is int && data.stars >= 0 && data.stars <= 30 &&
        data.avatar is string && (data.avatar == 'a' || data.avatar == 'b' || data.avatar == 'c' || data.avatar == 'd') &&
        data.createdAt is timestamp && data.createdAt == request.time;
    }

    // Connection test document
    match /test/{docId} {
      allow read: if true;
    }

    // Real-time Leaderboard collection
    match /leaderboard/{entryId} {
      allow read: if true;
      allow create: if isValidId(entryId) && isValidLeaderboard(request.resource.data);
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
